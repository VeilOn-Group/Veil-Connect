<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext. API pins are enforced in code (OkHttp CertificatePinner)
     from BuildConfig.API_PINS so they can rotate with a release. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
